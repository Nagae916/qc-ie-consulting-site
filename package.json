{
  "name": "qc-ie-consulting-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "gen": "npx -y contentlayer2 build",
    "test:frontmatter": "node scripts/test-frontmatter-normalization.cjs",
    "check:source-format": "node scripts/check-source-format.cjs",
    "check:frontmatter": "node scripts/check-frontmatter.js",
    "check:mdx-safety": "node scripts/guard-mdx.js",
    "fix:mdx-safety": "node scripts/guard-mdx.js --fix",
    "predev": "npm run test:frontmatter && npm run check:source-format && npm run check:frontmatter && npm run check:mdx-safety",
    "dev": "npm run gen && next dev -p 3000",
    "prebuild": "npm run test:frontmatter && npm run check:source-format && npm run check:frontmatter && npm run check:mdx-safety",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "build:next": "next build",
    "lint:fast": "next lint --max-warnings=0",
    "check:routes": "node ./scripts/check-routes.js",
    "check:dup": "node ./scripts/check-duplicate-urls.js",
    "check:audit": "node ./scripts/audit-guides.js",
    "check:knowledge-map": "node ./scripts/validate-engineer-knowledge-term-map.js",
    "check:engineer-exams": "node ./scripts/validate-engineer-past-exam-coverage.js",
    "check:generated": "node ./scripts/validate-generated-output.cjs",
    "check:build-output": "node ./scripts/validate-build-output.cjs",
    "check:agent-context": "node ./scripts/check-agent-context.cjs",
    "dashboard:site": "node ./scripts/generate-site-dashboard.cjs",
    "analyze:engineer-exams": "node scripts/analyze-engineer-past-exam-trends.js",
    "check:fast": "npm run test:frontmatter && npm run check:source-format && npm run check:frontmatter && npm run check:mdx-safety && npm run gen && npm run lint:fast && npm run check:routes && npm run check:dup && npm run check:audit && npm run check:knowledge-map && npm run check:engineer-exams && npm run check:generated",
    "check:ci": "node scripts/run-validation.cjs ci",
    "check:cross-platform": "node scripts/run-validation.cjs cross-platform",
    "guard": "npm run check:frontmatter && npm run check:mdx-safety",
    "check": "npm run check:fast",
    "typecheck": "tsc --noEmit",
    "lint:unused:code": "knip",
    "lint:unused:exports": "ts-prune -p tsconfig.json",
    "lint:unused:deps": "depcheck --ignores=@types/node --skip-missing=true --ignore-dirs=node_modules,.next,.contentlayer",
    "lint:graph": "madge --circular --extensions ts,tsx src pages",
    "lint:all": "npm run typecheck && npm run lint:unused:code && npm run lint:unused:exports && npm run lint:unused:deps && npm run lint:graph",
    "jev:test": "node --test scripts/jev/__tests__/*.test.mjs",
    "jev:review": "node scripts/jev/review-changes.mjs",
    "jev:compaction:sample": "node scripts/jev/sample-compaction.mjs",
    "jev:doctor": "node scripts/jev/doctor.mjs",
    "jev:smoke": "node scripts/jev/smoke.mjs",
    "jev:router": "node --env-file-if-exists=.env.local node_modules/jev-router/bin/jev-codex.mjs",
    "jev:router:metrics": "node scripts/jev/router-metrics.mjs",
    "jev:check": "npm run jev:test && npm run jev:review -- --dry-run && npm run jev:doctor",
    "codex:login": "codex login",
    "codex:status": "codex login status",
    "codex:jev": "node --env-file-if-exists=.env.local node_modules/jev-router/bin/jev-codex.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "contentlayer2": "^0.5.0",
    "katex": "^0.16.11",
    "next": "15.5.28",
    "next-contentlayer2": "^0.5.0",
    "react": "18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "18.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "rss-parser": "3.12.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@openai/codex": "0.155.0",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ai": "^7.0.106",
    "autoprefixer": "10.4.20",
    "depcheck": "^1",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-unused-imports": "^3",
    "jev-router": "^0.2.0",
    "knip": "^4",
    "madge": "^6",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.10",
    "ts-prune": "^0.10",
    "typescript": "5.5.4"
  },
  "overrides": {
    "eslint": "8.57.0"
  },
  "engines": {
    "node": "24.x"
  }
}
