# Preferred development-only direct TypeSafe connection. This one credential
# enables Review, Retention, and Router. Never commit a real value.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# JEV_API_KEY= # legacy alias supported by the Router and local tooling

# Optional fallback for Review and Retention through Vercel AI Gateway.
# Prefer VERCEL_OIDC_TOKEN from `vercel env pull .env.local` for local use.
# Use AI_GATEWAY_API_KEY for CI or other non-Vercel environments.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Optional Gateway and retention overrides. Defaults shown below.
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT_MS=8000
JEV_COMPACTION_MODE=shadow
JEV_DROP_THRESHOLD=0.95
JEV_RETENTION_MAX_CHARS=12000

# Router uses the direct TypeSafe credential above and never reuses a Gateway credential.
